{
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(python -m pip install -r requirements.txt)",
      "Bash(.venv/Scripts/python.exe -m pip install -r requirements.txt)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_tests.py\"",
            "timeout": 120,
            "statusMessage": "Running tests..."
          }
        ]
      }
    ]
  }
}
